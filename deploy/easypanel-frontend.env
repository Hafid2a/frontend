# ── Easypanel: خدمة frontend ───────────────────────────────────────────────
# انسخ الأسطر المناسبة (بدون #) إلى المتغيرات / Build Args حسب المنصة.
#
# ── الوضع 1: المتصفح يتصل مباشرة بالـ API (الافتراضي في Dockerfile) ───────
# على FastAPI لازم CORS_ORIGINS يتضمّن أصل الواجهة بالضبط، مثل:
#   https://najd-frontend.xxxx.easypanel.host
# و NEXT_PUBLIC_API_URL يُمرَّر وقت البناء (HTTPS عام يفتح من الإنترنت).
#
NEXT_PUBLIC_SITE_URL=https://najdofficial.com
NEXT_PUBLIC_API_URL=https://api.najdofficial.com
API_BASE_URL=https://api.najdofficial.com

NEXT_PUBLIC_MOCK_ORDERS=false

# ── معاينات *.easypanel.host (تلقائي في الكود) ───────────────────────────────
# الواجهة كتستعمل /api/backend من المتصفح تجنّباً لـ CORS؛ خادم Next خصّو:
#   BACKEND_INTERNAL_URL=http://اسم_خدمة_الباكند_في_Easypanel:8000
# (متغير تشغيل للحاوية، مش Build Arg.) بلا هاد العنوان الداخلي غادي يطيح 502.
#
# ── إجباري يدوياً: NEXT_PUBLIC_USE_API_PROXY=true وقت البناء ─────────────────
# إذا ما كنتش على easypanel.host (مثلاً دومين تجريبي آخر) وبغيتي نفس السلوك.

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
