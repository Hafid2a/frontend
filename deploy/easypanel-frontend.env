# ── Easypanel: خدمة frontend ───────────────────────────────────────────────
# انسخ الأسطر المناسبة (بدون #) إلى المتغيرات / Build Args حسب المنصة.
#
# ── الوضع 1: المتصفح يتصل مباشرة بالـ API (الافتراضي في Dockerfile) ───────
# على FastAPI لازم CORS_ORIGINS يتضمّن أصل الواجهة بالضبط، مثل:
#   https://najd-frontend.xxxx.easypanel.host
# و NEXT_PUBLIC_API_URL يُمرَّر وقت البناء (HTTPS عام يفتح من الإنترنت).
#
NEXT_PUBLIC_SITE_URL=https://najdofficial.com
NEXT_PUBLIC_API_URL=https://api.najdofficial.com
API_BASE_URL=https://api.najdofficial.com

NEXT_PUBLIC_MOCK_ORDERS=false

# ── معاينات *.easypanel.host (تلقائي في الكود) ───────────────────────────────
# الواجهة كتستعمل /api/backend من المتصفح تجنّباً لـ CORS؛ خادم Next يوجّه الطلب
# إلى (بالترتيب): BACKEND_INTERNAL_URL، ثم API_URL، API_BASE_URL، ثم NEXT_PUBLIC_API_URL.
# للشبكة الداخلية بين الخدمات: BACKEND_INTERNAL_URL=http://اسم_خدمة_الباكند:8000
# (تشغيل فقط، ليس Build Arg.) إن لم يُضبط وكان NEXT_PUBLIC_API_URL يصل من الحاوية،
# يُستخدم كاحتياطي.
#
# ── إختياري: NEXT_PUBLIC_USE_API_PROXY=true وقت البناء ───────────────────────
# فقط إن أردت تمرير الطلب عبر /api/backend (غير لازم على الدومين العام؛
# على معاينات *.easypanel.host يُفعّل البروكسي تلقائياً من الكود).

# تنبيه: NEXT_PUBLIC_* في Next.js تُخبز داخل bundle المتصفح وقت البناء فقط.
# على Easypanel: أضف هذه القيم تحت "Build Args" (وليس فقط Environment) قبل إعادة النشر.
NEXT_PUBLIC_META_PIXEL_ID=1956891195007947
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
