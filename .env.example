# ── محلي ──
# false = طلبات → الباكند (MaxMind). true = وهمي داخل Next فقط (أي طلب كيدوز — بدون فلتر دولة)
NEXT_PUBLIC_MOCK_ORDERS=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# للبروكسي: عيّن API_URL (سيرفر فقط) — في Docker/Easypanel غالباً: http://backend:8000 أو اسم خدمة الباكند
# بدون بادئة http:// يُضاف تلقائياً (مثلاً backend:8000)
API_URL=http://127.0.0.1:8000
# يُستعمل للمتصفح إن احتجت رابطاً عاماً؛ البروكسي يجرّب هذا بعد API_URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# INTERNAL_API_URL=http://api:8000
# ── إنتاج (Easypanel / Vercel) ── اضبط هناك بدل localhost
# NEXT_PUBLIC_SITE_URL=https://najdofficial.com
# NEXT_PUBLIC_API_URL=https://api.najdofficial.com

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
