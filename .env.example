# ── نسخ إلى .env.local للتطوير المحلي (npm run dev على localhost:3000) ──

NEXT_PUBLIC_MOCK_ORDERS=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# عنوان الباكند — يكفي واحد. API_BASE_URL نفس اسم متغير الباكند في Easypanel (يُقرأ للبروكسي ولـ NEXT_PUBLIC عبر next.config).
# • باكند محلي: API_BASE_URL=http://127.0.0.1:8000
# • باكند إنتاج من المتصفح المحلي: API_BASE_URL=https://api.najdofficial.com
#   (لازم CORS_ORIGINS في الباكند يتضمن http://localhost:3000)
API_BASE_URL=https://api.najdofficial.com

# اختياري إن احتجت تجاوز صريح (يغلب القيم أعلاه إن وُجد)
# NEXT_PUBLIC_API_URL=https://api.najdofficial.com
# API_URL=http://127.0.0.1:8000

# ── Easypanel (إنتاج) — على خدمة الفرونت فقط ──
# جرّب عنوان HTTP داخلي أولاً (من نفس مشروع Docker). انسخه من واجهة الباكند إن وُجد.
# API_INTERNAL_URLS=http://backend:8000
# غيّر البورت إن لزم: API_INTERNAL_PORT=8000
# إن احتجت الـ https العام قبل الداخلي: API_PROXY_INTERNAL_FIRST=0

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
