# انسخ إلى .env.local — npm run dev

# true = محاكاة طلبات داخل Next بدون FastAPI. false = API حقيقي (+ Postgres).
NEXT_PUBLIC_MOCK_ORDERS=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# عنوان الباكند للمتصفح (اتصال مباشر — افتراضي التطوير). شغّل FastAPI على 8000،
# أو ضع NEXT_PUBLIC_MOCK_ORDERS=true أعلاه للواجهة وحدها.
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = تمرير الطلبات عبر /api/backend من خادم Next (مثل اختبار البروكسي أو إن رغبت بتفادي CORS يدوياً). الافتراضي: false
# NEXT_PUBLIC_USE_API_PROXY=true
# مع البروكسي فقط: BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# في MOCK: افتراضياً يُقبل فقط 0550505044 من «خارج السعودية». لأي جوال سعودي صالح محلياً:
# NEXT_PUBLIC_MOCK_ALLOW_ANY_SAUDI=true

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
