# ── نسخ إلى .env.local للتطوير المحلي (npm run dev على localhost:3000) ──

NEXT_PUBLIC_MOCK_ORDERS=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# عنوان الباكند للمتصفح (طلبات مباشرة؛ لازم CORS على الباكند لأصل الموقع).
# محلياً أضف http://localhost:3000 إلى CORS_ORIGINS في الباكند.
# يُشتق NEXT_PUBLIC_API_URL في next.config من أحد هذه إن لم تضبطه صراحةً.
# • باكند محلي: API_BASE_URL=http://127.0.0.1:8000
# • إنتاج من المتصفح المحلي: API_BASE_URL=https://api.najdofficial.com
API_BASE_URL=https://api.najdofficial.com

# اختياري: تجاوز صريح للعنوان العام للـ API
# NEXT_PUBLIC_API_URL=https://api.najdofficial.com

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
